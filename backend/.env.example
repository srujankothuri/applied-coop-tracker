# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers), with the
# database user's password in place of <db_password>.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?retryWrites=true&w=majority
DB_NAME=applied

# Any long random string, used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

PORT=3000

# Password given to the demo accounts created by `npm run seed`
DEMO_PASSWORD=choose-a-demo-password
